# ==============================================================================
# InnovEity CRM Frontend Environment Configuration Template
# Copy this file to .env or .env.local for development.
# For production build, use .env.production or pass VITE_API_URL during `npm run build`.
# NOTE: Vite compiles VITE_* variables into client bundles at BUILD time.
# After updating any variable, rebuild the frontend using `npm run build`.
# ==============================================================================

# API Base URL for backend communication
# - Local development: http://localhost:5000/api (or http://localhost:3002/api)
# - Production required: https://crm.innoveity.tech/api (or relative /api)
VITE_API_URL=http://localhost:5000/api

# Optional Socket.IO Real-Time Server URL
# If omitted, the client automatically infers the socket origin from VITE_API_URL
# - Local development: http://localhost:5000
# - Production: https://crm.innoveity.tech
# VITE_SOCKET_URL=http://localhost:5000

# Leaflet + OpenStreetMap Configuration (Zero API key or billing required)
# Default tiles: OpenStreetMap standard tile server
# VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Place Geocoding & Search Provider (Defaults to Photon API powered by OpenStreetMap)
# VITE_PHOTON_API_URL=https://photon.komoot.io/api/
# VITE_PHOTON_REVERSE_URL=https://photon.komoot.io/reverse

# Optional Fallback Geocoding Provider
# VITE_GEOCODE_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
