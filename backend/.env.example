# ==============================================================================
# InnovEity CRM Backend Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# Never commit active credentials, production secrets, or private keys to source control.
# ==============================================================================

# Node Environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server Port
# - Development default: 5000
# - Production required: 3002
PORT=5000

# Database Connection URL (Prisma with MySQL)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Local default: mysql://root:password@localhost:3306/innoveity_crm
DATABASE_URL="mysql://root:password@localhost:3306/innoveity_crm"

# JWT Secret Key for Session Authentication & Token Signing
# Use a cryptographically secure random string of at least 32 characters in production.
JWT_SECRET="replace_with_a_secure_random_jwt_secret_for_production"

# Frontend Origin URL (used for CORS and generated links in emails)
# - Development default: http://localhost:5173
# - Production required: https://crm.innoveity.tech
FRONTEND_URL="http://localhost:5173"

# Additional Allowed Origins (CORS whitelist, comma-separated)
# In production, specify the authoritative domain(s).
# In development, localhost ports (5173, 5174, 3000, 3002) are permitted automatically.
ALLOWED_ORIGINS="https://crm.innoveity.tech"

# Production Domain (used by deployment diagnostics)
PRODUCTION_DOMAIN="crm.innoveity.tech"

# Multi-Tenant Mode Flag ('true' or 'false')
MULTI_TENANT_ENABLED=true

# SMTP Mail Server Configuration (Optional for development; required for transactional emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@example.com"
SMTP_PASS="app_specific_password_here"

# Branding and Email Sender Details
COMPANY_NAME="InnovEity"
SENDER_EMAIL="no-reply@innoveity.tech"
