model AssetEstimate {
  id                 String             @id @default(uuid())
  organizationId     String?
  createdById        String?
  estimateNumber     String
  estimateDate       DateTime           @default(now())
  reference          String?
  placeOfSupply      String?
  status             String             @default("GENERATED")
  title              String             @default("Estimate")

  // Company / Issuer snapshot
  companyName        String
  companyAddress     String?            @db.Text
  companyCity        String?
  companyState       String?
  companyPincode     String?
  companyCountry     String?            @default("India")
  companyPhone       String?
  companyEmail       String?
  companyGstin       String?
  companyLogo        String?

  // Bill To / Recipient snapshot
  billToName         String
  billToAddress      String?            @db.Text
  billToCity         String?
  billToState        String?
  billToPincode      String?
  billToCountry      String?            @default("India")
  billToGstin        String?

  // Financial snapshot
  subTotal           Float              @default(0)
  cgstRate           Float              @default(0)
  sgstRate           Float              @default(0)
  igstRate           Float              @default(0)
  cgstAmount         Float              @default(0)
  sgstAmount         Float              @default(0)
  igstAmount         Float              @default(0)
  grandTotal         Float              @default(0)
  totalInWords       String             @db.Text

  // Banking & Terms snapshot
  bankName           String?
  bankIfsc           String?
  bankAccountNo      String?
  bankBranch         String?
  notes              String?            @db.Text
  termsAndConditions Json?
  signatureImage     String?
  signatoryTitle     String?            @default("Authorized Signature")

  // Cancellation metadata
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?            @db.Text

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items              AssetEstimateItem[]

  @@unique([organizationId, estimateNumber])
  @@index([organizationId])
  @@index([estimateNumber])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, estimateDate])
  @@index([organizationId, billToName])
  @@map("assetestimate")
}

