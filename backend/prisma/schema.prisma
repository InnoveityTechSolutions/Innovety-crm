  originalFileName String
  fileType         String
  fileSize         Int
  uploadedById     String
  uploadedBy       User         @relation("UserCompanyDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)
  expiryDate       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([expiryDate])
  @@map("companydocument")
}

model AttendanceLocation {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation("OrganizationAttendanceLocations", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?       @db.Text
  latitude       Float
  longitude      Float
  radiusMeters   Float         @default(100.0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignedUsers  UserAttendanceLocation[]
  attendances    Attendance[]  @relation("LocationAttendances")

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("attendancelocation")
}

model UserAttendanceLocation {
  id                   String             @id @default(uuid())
  userId               String
  attendanceLocationId String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceLocation   AttendanceLocation @relation(fields: [attendanceLocationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())

  @@unique([userId, attendanceLocationId])
  @@index([userId])
  @@index([attendanceLocationId])
  @@map("userattendancelocation")
}

enum AccessLevel {
  VIEW
  EDIT
}

model AccessTemplate {
  id              String                     @id @default(cuid())
  name            String
  description     String?                    @db.Text
  baseRole        Role
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status          String                     @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdById     String?
  createdBy       User?                      @relation("CreatedAccessTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  assignedUsers   User[]                     @relation("UserAccessTemplate")
  permissions     AccessTemplatePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([baseRole])
  @@index([status])
  @@map("accesstemplate")
}

model AccessTemplatePermission {
  id          String         @id @default(cuid())
  templateId  String
  template    AccessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  moduleKey   String
  accessLevel AccessLevel    @default(VIEW)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([templateId, moduleKey])
  @@index([templateId])
  @@map("accesstemplatepermission")
}

model Meeting {
  id             String            @id @default(uuid())
  organizationId String
  title          String
  description    String?           @db.Text
  date           DateTime
  startTime      DateTime
  endTime        DateTime
  organizerId    String
  googleMeetUrl  String?
  status         MeetingStatus     @default(UPCOMING)
  projectId      String?
  teamId         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation("OrganizationMeetings", fields: [organizationId], references: [id], onDelete: Cascade)
  organizer      User              @relation("OrganizedMeetings", fields: [organizerId], references: [id], onDelete: Cascade)
  project        Project?          @relation("ProjectMeetings", fields: [projectId], references: [id], onDelete: SetNull)
  team           Team?             @relation("TeamMeetings", fields: [teamId], references: [id], onDelete: SetNull)
  attendees      MeetingAttendee[]
  report         MeetingReport?

  @@index([organizationId])
  @@index([organizerId])
  @@index([projectId])
  @@index([teamId])
  @@index([date])
  @@index([status])
  @@map("meeting")
}

model MeetingAttendee {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation("UserMeetingAttendances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
  @@map("meetingattendee")
}

model MeetingReport {
  id            String    @id @default(uuid())
  meetingId     String    @unique
  summary       String    @db.Text
  followUpTasks Json?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("MeetingReportCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("meetingreport")
}

model CompOffCredit {
  id                 String       @id @default(uuid())
  organizationId     String
  userId             String
  workDate           DateTime     @db.Date
  attendanceId       String?
  creditDays         Float        @default(1.0)
  usedDays           Float        @default(0.0)
  availableDays      Float        @default(1.0)
  earnedAt           DateTime     @default(now())
  expiresAt          DateTime
  status             String       @default("APPROVED")
  reason             String       @db.Text
  claimedByRole      String
  claimedById        String
  tlApprovedById     String?
  tlApprovedAt       DateTime?
  tlRemarks          String?
  adminApprovedById  String?
  adminApprovedAt    DateTime?
  adminRemarks       String?
  sessionId          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User         @relation("UserCompOffCredits", fields: [userId], references: [id], onDelete: Cascade)
  attendance         Attendance?          @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  consumptions       CompOffConsumption[]

  @@unique([userId, workDate])
  @@index([organizationId])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([workDate])
  @@index([status])
  @@index([sessionId])
  @@map("compoffcredit")
}

model CompOffConsumption {
  id             String        @id @default(uuid())
  organizationId String
  creditId       String
  leaveRequestId String
  userId         String
  consumedDays   Float
  status         String        @default("CONSUMED") // CONSUMED, RESTORED
  restoredAt     DateTime?
  restoredById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credit         CompOffCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest  @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  user           User          @relation("UserCompOffConsumptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, creditId])
  @@index([organizationId])
  @@index([creditId])
  @@index([leaveRequestId])
  @@index([userId])
  @@index([status])
  @@map("compoffconsumption")
}

model CompOffPermissionRequest {
  id              String        @id @default(uuid())
  organizationId  String
  userId          String
  workDate        DateTime      @db.Date
  holidayType     String        @default("WEEKLY_OFF")
  reason          String        @db.Text
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?       @db.Text
  adminRemarks    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User          @relation("UserCompOffPermissionRequests", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?         @relation("ApprovedCompOffPermissionRequests", fields: [approvedById], references: [id], onDelete: SetNull)
  session         CompOffSession?

  @@unique([userId, workDate])
  @@index([organizationId])
  @@index([userId, status])
  @@index([workDate])
  @@index([status])
  @@map("compoffpermissionrequest")
}

model CompOffSession {
  id                  String                   @id @default(uuid())
  organizationId      String
  userId              String
  permissionRequestId String                   @unique
  workDate            DateTime                 @db.Date
  loginTime           DateTime
  clockOutTime        DateTime?
  durationHours       Decimal                  @default(0.00) @db.Decimal(5, 2)
  status              String                   @default("ACTIVE") // ACTIVE, COMPLETED
  clockOutType        String?                  // MANUAL, AUTO
  latitude            Decimal?                 @db.Decimal(10, 7)
  longitude           Decimal?                 @db.Decimal(10, 7)
  locationStatus      String                   @default("INSIDE") // INSIDE, OUTSIDE
  locationName        String?
  distanceMeters      Int?
  allowedRadiusMeters Int?
  locationReason      String?                  @db.Text
  flaggedForReview    Boolean                  @default(false)
  ipAddress           String?
  device              String?
  browser             String?
  autoClockOutTarget  DateTime?
  approvalStatus      String                   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminApprovedById   String?
  adminApprovedAt     DateTime?
  adminRemarks        String?                  @db.Text
  rejectionReason     String?                  @db.Text
  creditId            String?
  calculatedCredit    Decimal?                 @db.Decimal(3, 1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                     @relation("UserCompOffSessions", fields: [userId], references: [id], onDelete: Cascade)
  permissionRequest   CompOffPermissionRequest @relation(fields: [permissionRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([organizationId])
  @@index([userId, status])
  @@index([status])
  @@index([approvalStatus])
  @@index([autoClockOutTarget])
  @@map("compoffsession")
}


