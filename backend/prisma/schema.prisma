model Shift {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  startTime      String        // HH:mm format, e.g. "09:00"
  endTime        String        // HH:mm format, e.g. "18:00"
  workingDays    Json          // e.g. ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]
  status         String        @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ShiftMember[]
  history        ShiftHistory[]
  schedules      ShiftSchedule[]
  recurringTemplates RecurringShiftTemplate[]

  @@index([organizationId])
  @@index([organizationId, status])

  @@map("shift")
}

model ShiftMember {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String   @unique
  createdAt DateTime @default(now())

  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([userId])

  @@map("shiftmember")
}

model ShiftHistory {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String?
  action    String   // SHIFT_CREATED, SHIFT_EDITED, MEMBERS_ASSIGNED, MEMBERS_REMOVED, SHIFT_ACTIVATED, SHIFT_DEACTIVATED, SHIFT_DUPLICATED
  details   String?
  createdAt DateTime @default(now())

  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([shiftId, createdAt])

  @@map("shifthistory")
}

model ShiftSchedule {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  shiftId        String
  startDate      DateTime
  endDate        DateTime
  type           String    // PLANNED, OVERRIDE, SWAP
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  reason         String?
  swapWithUserId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserShiftSchedules", fields: [userId], references: [id], onDelete: Cascade)
  swapWithUser   User?        @relation("UserSwapSchedules", fields: [swapWithUserId], references: [id], onDelete: SetNull)
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("ShiftScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId, startDate, endDate])
  @@index([organizationId, startDate, endDate])
  @@index([status])

  @@map("shiftschedule")
}

model ShiftNotification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String       // SHIFT_START_1H, SHIFT_CHANGED, OVERRIDE_ASSIGNED, SWAP_APPROVED, TOMORROW_SUMMARY, LATE_ALERT
  title          String
  message        String
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId, isRead])
  @@index([userId, createdAt])

  @@map("shiftnotification")
}

model ShiftApproval {
  id             String       @id @default(cuid())
  organizationId String
  requesterId    String
  approverId     String?
  requestType    String       // SHIFT_SWAP, TEMPORARY_OVERRIDE, WEEKEND_OVERRIDE, HOLIDAY_WORK
  status         String       @default("PENDING_TL_APPROVAL") // PENDING_TL_APPROVAL, PENDING_ADMIN_APPROVAL, APPROVED, REJECTED
  reason         String?
  details        Json?        // { shiftId, targetDate, startDate, endDate, swapWithUserId, overrideReason, etc. }
  adminNote      String?
  tlNote         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester      User         @relation("ShiftApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver       User?        @relation("ShiftApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([requesterId])
  @@index([status])

  @@map("shiftapproval")
}

model RecurringShiftTemplate {
