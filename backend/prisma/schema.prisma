datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPER_ADMIN
  TEAM_LEADER
  INTERN
  EMPLOYEE
}

enum TicketCategory {
  TECHNICAL
  PROJECT
  HR
  SOFTWARE
  HARDWARE
  GENERAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAITING_FOR_REVIEW
  APPROVED
  REJECTED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectType {
  CLIENT
  INTERNAL
  MAINTENANCE
  RND
  TRAINING
}

enum ProjectRole {
  PROJECT_LEADER
  TEAM_LEADER
  MEMBER
  OBSERVER
}

enum ChatRoomStatus {
  ACTIVE
  ARCHIVED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WorkLogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum WorkCalendarStatus {
  WORKING_DAY
  WFH
  HOLIDAY
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  LEAVE
  WORK_FROM_HOME
  MISSED
}

enum MeetingStatus {
  UPCOMING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

model User {
  id               String           @id @default(uuid())
  employeeId       String           @unique // Auto-generated string (e.g. IN-1001)
  name             String
  email            String           @unique
  password         String
  phone            String?
  dob              DateTime?        // Date of birth
  college          String?
  department       String?
  joiningDate      DateTime         @default(now())
  role             Role             @default(INTERN)
  status           String           @default("ACTIVE") // ACTIVE, INACTIVE
  profilePic       String?          // File path/URL
  candidateType    String?          // Student, Graduate, Intern, Fresher, Professional
  resume           String?          // File path/URL for PDF/DOC/DOCX
  degree           String?
  currentYearSemester String?
  graduationYear   String?
  internshipRole   String?
  internshipDuration String?
  highestQualification String?
  keySkills        String?
  companyName      String?
  designation      String?
  totalExperience  String?
  notificationPreferences Json?
  customData              Json?
  casualLeaveQuota        Int              @default(12)
  sickLeaveQuota          Int              @default(12)
  emergencyLeaveQuota     Int              @default(6)
  resetOtpHash            String?
  resetOtpExpiry          DateTime?
  resetOtpAttempts        Int              @default(0)
  lastOtpSentAt           DateTime?
  resetTokenHash          String?
  resetTokenExpiry        DateTime?
  otpHourlyCount          Int              @default(0)
  otpHourlyWindowStart    DateTime?
  welcomePopupSeen        Boolean          @default(false)

  // Organization Structure Relations & Fields
  organizationId          String?
  organization            Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  positionId              String?
  position                Position?              @relation("UserPosition", fields: [positionId], references: [id], onDelete: SetNull)
  branchId                String?
  branch                  OrgBranch?             @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  departmentId            String?
  departmentRef           DepartmentMaster?      @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  designationId           String?
  designationRef          DesignationMaster?     @relation("UserDesignation", fields: [designationId], references: [id], onDelete: SetNull)
  reportingManagerId      String?
  reportingManager        User?                  @relation("ReportingHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates            User[]                 @relation("ReportingHierarchy")
  gender                  String?
  shiftId                 String?
  shiftRef                ShiftMaster?           @relation("UserShift", fields: [shiftId], references: [id], onDelete: SetNull)
  employmentType          String?
  probationPeriod         String?
  autoClockOutEnabled     Boolean                @default(true)

  // Access Template Relations (Phase 1)
  accessTemplateId        String?
  accessTemplate          AccessTemplate?        @relation("UserAccessTemplate", fields: [accessTemplateId], references: [id], onDelete: SetNull)
  createdAccessTemplates  AccessTemplate[]       @relation("CreatedAccessTemplates")

  // Future-Ready Enterprise Placeholders
  grade                   String?
  jobLevel                String?
  costCenter              String?
  businessUnit            String?
  workLocation            String?
  promotionEligible       Boolean                @default(false)
  promotionDate           DateTime?

  // Position History
  positionHistories       PositionHistory[]      @relation("UserPositionHistory")
  changedPositionHistories PositionHistory[]     @relation("ChangedByPositionHistory")

  // Promotion History
  promotionHistories      PromotionHistory[]     @relation("UserPromotionHistory")
  promotionsPerformed     PromotionHistory[]     @relation("PromotedByHistory")

  createdAt               DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  ledTeams         Team[]           @relation("TeamLeader")
  teamMembers      TeamMember[]
  attendances      Attendance[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  createdTasks     Task[]           @relation("TaskCreator")
  reviewedTasks    Task[]           @relation("TaskReviewer")
  createdReviewHistory TaskReviewHistory[] @relation("TaskReviewHistoryCreator")
  submissions      TaskSubmission[]
  raisedTickets    Ticket[]         @relation("TicketCreator")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  announcements          Announcement[]   @relation("AnnouncementCreator")
  receivedAnnouncements  Announcement[]   @relation("AnnouncementTargetUser")
  notifications          Notification[]
  activityLogs     ActivityLog[]
  comments         Comment[]
  leaves           LeaveRequest[]   @relation("UserLeaves")
  userLeaveBalances UserLeaveBalance[]
  leaveCreditHistories LeaveCreditHistory[]
  assignedAssets        Asset[]           @relation("UserAssignedAssets")
  assetAssignmentHistory AssetAssignment[] @relation("UserAssignmentHistory")
  assetAssignedByHistory AssetAssignment[] @relation("UserAssignedByHistory")
  chatMemberships        ChatRoomMember[]
  sentChatMessages       ChatMessage[]     @relation("ChatSender")
  messageReads           MessageRead[]
  assignedAttendanceLocations UserAttendanceLocation[]

  // Project Relations
  createdProjects          Project[]         @relation("ProjectCreator")
  ledProjects              Project[]         @relation("ProjectLeader")
  projectMemberships       ProjectMember[]
  uploadedProjectDocuments ProjectDocument[]
  projectHistory           ProjectHistory[]  @relation("ProjectHistoryUser")
  workLogs                 WorkLog[]
  aiFeedbacks              AIFeedback[]
  createdFormVersions      CustomFormVersion[]
  performedBuilderHistory  BuilderHistory[]
  salaryStructure          SalaryStructure?  @relation("UserSalaryStructure")
  salaryRevisions          SalaryRevision[]  @relation("UserSalaryRevisions")
  performedRevisions       SalaryRevision[]  @relation("RevisedByRevisions")
  payslips                 Payslip[]         @relation("UserPayslips")
  processedBatches         PayrollBatch[]    @relation("ProcessedBatches")
  stageApprovals           ProjectWorkflowStage[]   @relation("StageApprover")
  requestedStageAudits     TaskStageApprovalAudit[] @relation("StageAuditRequestedBy")
  approvedStageAudits      TaskStageApprovalAudit[] @relation("StageAuditApprovedBy")
  createdWorkCalendars     WorkCalendar[]           @relation("WorkCalendarCreator")
  shiftAssignment          ShiftMember?
  shiftHistories           ShiftHistory[]
  shiftSchedules           ShiftSchedule[]          @relation("UserShiftSchedules")
  swapShiftSchedules       ShiftSchedule[]          @relation("UserSwapSchedules")
  createdShiftSchedules    ShiftSchedule[]          @relation("ShiftScheduleCreator")
  shiftNotifications       ShiftNotification[]
  shiftApprovalsRequested  ShiftApproval[]          @relation("ShiftApprovalRequester")
  shiftApprovalsDecided    ShiftApproval[]          @relation("ShiftApprovalApprover")
  shiftExceptions          ShiftException[]         @relation("UserShiftExceptions")
  shiftExceptionsResolved  ShiftException[]         @relation("ResolvedShiftExceptions")
  hostedVisitors           Visitor[]                @relation("HostVisitors")
  documents                EmployeeDocument[]       @relation("UserDocuments")
  uploadedDocuments        EmployeeDocument[]       @relation("UploadedByDocuments")
  connectedIntegrations    ExternalIntegration[]    @relation("ConnectedIntegrations")
  performedAuditLogs       OrganizationAuditLog[]   @relation("AuditPerformedBy")
  targetAuditLogs          OrganizationAuditLog[]   @relation("AuditTargetUser")
  companyDocuments         CompanyDocument[]        @relation("UserCompanyDocuments")

  // Meetings Relations
  organizedMeetings        Meeting[]                @relation("OrganizedMeetings")
  meetingAttendances       MeetingAttendee[]        @relation("UserMeetingAttendances")
  createdMeetingReports    MeetingReport[]          @relation("MeetingReportCreator")

  // Comp-Off Relations
  compOffCredits           CompOffCredit[]          @relation("UserCompOffCredits")
  compOffConsumptions      CompOffConsumption[]     @relation("UserCompOffConsumptions")
  compOffPermissionRequests CompOffPermissionRequest[] @relation("UserCompOffPermissionRequests")
  approvedCompOffPermissions CompOffPermissionRequest[] @relation("ApprovedCompOffPermissionRequests")
  compOffSessions          CompOffSession[]         @relation("UserCompOffSessions")

  @@map("user")
}

model Position {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  code           String
  level          Int
  description    String?
  color          String            @default("#4F46E5")
  textColor      String            @default("#FFFFFF")
  icon           String            @default("Award")
  priority       Int               @default(0)
  sortOrder      Int               @default(0)
  status         String            @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]            @relation("UserPosition")
  oldInHistory   PositionHistory[] @relation("OldPositionHistory")
  newInHistory   PositionHistory[] @relation("NewPositionHistory")
  prevInPromotions PromotionHistory[] @relation("PrevPromotionPosition")
  nextInPromotions PromotionHistory[] @relation("NextPromotionPosition")

  @@index([organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([organizationId, level])

  @@map("position")
}

model PositionHistory {
  id            String    @id @default(uuid())
  userId        String
  oldPositionId String?
  newPositionId String?
  changedById   String?
  effectiveDate DateTime  @default(now())
  reason        String?
  createdAt     DateTime  @default(now())

  user          User      @relation("UserPositionHistory", fields: [userId], references: [id], onDelete: Cascade)
  oldPosition   Position? @relation("OldPositionHistory", fields: [oldPositionId], references: [id], onDelete: SetNull)
  newPosition   Position? @relation("NewPositionHistory", fields: [newPositionId], references: [id], onDelete: SetNull)
  changedBy     User?     @relation("ChangedByPositionHistory", fields: [changedById], references: [id], onDelete: SetNull)

  @@map("positionhistory")
}

model PromotionHistory {
  id                 String    @id @default(uuid())
  userId             String
  previousRole       Role
  newRole            Role
  previousPositionId String?
  newPositionId     String?
  previousEmployeeId String
  newEmployeeId     String
  promotedById       String?
  promotionReason    String?
  effectiveDate      DateTime  @default(now())
  createdAt          DateTime  @default(now())

  user               User      @relation("UserPromotionHistory", fields: [userId], references: [id], onDelete: Cascade)
  previousPosition   Position? @relation("PrevPromotionPosition", fields: [previousPositionId], references: [id], onDelete: SetNull)
  newPosition        Position? @relation("NextPromotionPosition", fields: [newPositionId], references: [id], onDelete: SetNull)
  promotedBy         User?     @relation("PromotedByHistory", fields: [promotedById], references: [id], onDelete: SetNull)

  @@map("promotionhistory")
}

model OrgBranch {
  id               String        @id @default(uuid())
  organizationId   String?
  name             String
  code             String
  address          String?
  city             String?
  country          String?       @default("India")
  timezone         String        @default("Asia/Kolkata")
  workingHoursRef  String?       @default("09:00 - 18:00")
  status           String        @default("ACTIVE")
  isArchived       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization? @relation("CompanyBranches", fields: [organizationId], references: [id], onDelete: Cascade)
  users            User[]        @relation("UserBranch")
  assets           Asset[]       @relation("BranchAssets")
  visitors         Visitor[]     @relation("BranchVisitors")
  events           OrganizationEvent[] @relation("BranchEvents")

  @@index([organizationId])
  @@index([organizationId, status])

  @@map("orgbranch")
}

model DepartmentMaster {
  id             String              @id @default(uuid())
  organizationId String?
  name           String
  code           String
  description    String?
  status         String              @default("ACTIVE")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]              @relation("UserDepartment")
  designations   DesignationMaster[]

  @@index([organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, name])

  @@map("departmentmaster")
}

model DesignationMaster {
  id             String            @id @default(uuid())
  organizationId String?
  name           String
  code           String
  departmentId   String?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     DepartmentMaster? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users          User[]            @relation("UserDesignation")

  @@index([organizationId])
  @@unique([organizationId, code])
  @@unique([organizationId, name])

  @@map("designationmaster")
}

model ShiftMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  startTime String   @default("09:30")
  endTime   String   @default("18:30")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]   @relation("UserShift")

  @@map("shiftmaster")
}

model EmploymentTypeMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employmenttypemaster")
}


model Team {
  id             String       @id @default(uuid())
  organizationId String?
  name           String       @unique
  description    String?
  leaderId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  leader        User?          @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  tasks         Task[]
  announcements Announcement[]
  chatRooms     ChatRoom[]
  projects      Project[]
  meetings      Meeting[]      @relation("TeamMeetings")

  @@index([organizationId])

  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  joinedAt  DateTime @default(now())

  // Relations
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])

  @@map("teammember")
}

model Attendance {
  id               String           @id @default(uuid())
  userId           String
  date             DateTime         @db.Date
  clockIn          DateTime?
  clockOut         DateTime?
  clockInLocation  String?
  clockOutLocation String?
  clockInLatitude  Float?
  clockInLongitude Float?
  clockInAddress   String?          @db.Text
  clockOutLatitude Float?
  clockOutLongitude Float?
  clockOutAddress  String?          @db.Text
  clockOutWorkLocation String?
  clockOutWorkLocationOther String?
  ipAddress    String?
  browser      String?
  device       String?
  workingHours Float?           // Decimals representing decimal hours
  status       AttendanceStatus @default(PRESENT)
  editedBy     String?          // User ID who edited attendance
  lateMinutes     Int?
  earlyWindowUsed Int?
  gracePeriodUsed Int?
  shiftStartUsed   String?
  workLocation     String?          // OFFICE, HOME, OTHER
  workLocationOther String?        // Text description if OTHER
  shiftEndAt       DateTime?
  autoClockOut     Boolean          @default(false)
  clockOutReason   String?
  shiftId          String?
  shiftName        String?
  scheduledStartTime String?
  scheduledEndTime   String?
  attendanceLocationId String?
  attendanceLocation   AttendanceLocation? @relation("LocationAttendances", fields: [attendanceLocationId], references: [id], onDelete: SetNull)
  compOffCredits       CompOffCredit[]

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([attendanceLocationId])
  @@map("attendance")
}

model Task {
  id                  String                   @id @default(uuid())
  organizationId      String?
  title               String
  description         String                   @db.Text
  priority            TaskPriority             @default(MEDIUM)
  status              TaskStatus               @default(PENDING)
  deadline            DateTime
  teamId              String?
  assigneeId          String?
  creatorId           String
  attachments         Json?                    // List of file paths
  type                String?                  @default("TASK") // TASK, BUG, STORY
  storyPoints         Int?                     @default(0)
  sprintName          String?
  projectId           String?
  milestoneId         String?
  estimatedHours      Float?                   @default(0)
  actualHours         Float?                   @default(0)
  approvalStatus      ApprovalStatus           @default(NOT_REQUIRED)
  stageId             String?
  stageApprovalStatus ApprovalStatus           @default(NOT_REQUIRED)
  reviewStatus        String                   @default("PENDING") // PENDING, APPROVED, REJECTED, RESUBMITTED
  correctionText      String?                  @db.Text
  correctionAudioUrl  String?
  reviewedById        String?
  reviewedAt          DateTime?
  resubmittedAt       DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  organization        Organization?            @relation("CompanyTasks", fields: [organizationId], references: [id], onDelete: SetNull)
  team                Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project             Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone           ProjectMilestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  stage               ProjectWorkflowStage?    @relation("TaskStage", fields: [stageId], references: [id], onDelete: SetNull)
  assignee            User?                    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator             User                     @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  reviewedBy          User?                    @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submissions         TaskSubmission[]
  comments            Comment[]
  history             TaskHistory[]
  reviewHistory       TaskReviewHistory[]
  subtasks            Subtask[]
  chatRooms           ChatRoom[]
  dependents          TaskDependency[]         @relation("TaskDependents")
  prerequisites       TaskDependency[]         @relation("TaskPrerequisites")
  workLogs            WorkLog[]
  stageApprovalAudits TaskStageApprovalAudit[]

  @@index([organizationId])

  @@map("task")
}

model TaskSubmission {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  submitNotes String?  @db.Text
  files       Json?    // File paths/URLs uploaded by intern
  submittedAt DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasksubmission")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  text      String   @db.Text
  audioUrl  String?
  type      String?  @default("TEXT") // TEXT, AUDIO
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comment")
}

model TaskReviewHistory {
  id           String   @id @default(uuid())
  taskId       String
  action       String   // SUBMITTED, APPROVED, REJECTED, RESUBMITTED
  message      String?  @db.Text
  audioUrl     String?
  createdById  String
  createdAt    DateTime @default(now())

  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User     @relation("TaskReviewHistoryCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("taskreviewhistory")
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId      String
  userId      String
  action      String   // "STATUS_CHANGE", "ASSIGNED", "EDITED", "SUBMITTED", "COMMENT"
  detail      String
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("taskhistory")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  DAMAGED
  DISPOSED
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  MOBILE
  PHONE
  ID_CARD
  ACCESSORIES
  KEYBOARD
  MOUSE
  HEADSET
  TABLET
  PRINTER
  NETWORK
  FURNITURE
  OTHER
}

model Asset {
  id             String          @id @default(uuid())
  organizationId String?
  assetId        String          @unique // Auto-generated e.g. AST-1001
  name           String
  category       String          @default("LAPTOP")
  brand          String?
  model          String?
  serialNumber   String?         @unique
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  cost           Float?
  vendor         String?
  location       String?
  branchId       String?
  branch         OrgBranch?      @relation("BranchAssets", fields: [branchId], references: [id], onDelete: SetNull)
  condition      String?         @default("EXCELLENT") // EXCELLENT, GOOD, FAIR, DAMAGED
  issueDate      DateTime?
  returnDate     DateTime?
  billPhoto      String?         // File path / URL for bill/invoice photocopy
  status         AssetStatus     @default(AVAILABLE)
  description    String?
  quantity       Int             @default(1)
  
  // Current assignment snapshot / relation
  assignedToId   String?
  assignedTo     User?           @relation("UserAssignedAssets", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDate   DateTime?
  expectedReturn DateTime?
  notes          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignments    AssetAssignment[]
  tickets        Ticket[]
  estimateItems  AssetEstimateItem[]

  @@index([organizationId])
  @@index([branchId])

  @@map("asset")
}

model AssetAssignment {
  id             String      @id @default(uuid())
  assetId        String
  userId         String
  assignedById   String?
  assignedDate   DateTime    @default(now())
  expectedReturn DateTime?
  returnDate     DateTime?
  conditionOnReturn String?   // Good, Damaged, Lost, Needs Repair
  remarks        String?
  notes          String?
  status         String      @default("ACTIVE") // ACTIVE, RETURNED

  asset          Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user           User        @relation("UserAssignmentHistory", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User?       @relation("UserAssignedByHistory", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@map("assetassignment")
}

model Ticket {
  id             String         @id @default(uuid())
  organizationId String?
  title          String
  description    String
  category       TicketCategory
  status         TicketStatus   @default(OPEN)
  creatorId      String
  assigneeId     String?
  assetId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creator        User           @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset          Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([organizationId])

  @@map("ticket")
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  content      String
  creatorId    String
  targetType   String   @default("ALL") // "ALL", "TEAM", "INDIVIDUAL"
  targetTeamId String?
  targetUserId String?
  createdAt    DateTime @default(now())

  creator      User     @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  targetTeam   Team?    @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AnnouncementTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("announcement")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
