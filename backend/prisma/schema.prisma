  salaryStructures SalaryStructure[] @relation("CompanySalaryStructures")
  salaryRevisions SalaryRevision[] @relation("CompanySalaryRevisions")
  payrollBatches PayrollBatch[]   @relation("CompanyPayrollBatches")
